# Copy to .env and fill in for a real (non-demo) deployment.
# None of these are required to try Conduit locally in mock mode —
# `go run ./cmd/gateway` or `docker run conduit` work with zero env vars set.

# Set to "production" to enforce strict startup checks (e.g. requires
# CONDUIT_ENCRYPTION_KEY to be set — falls back to a dev-only key otherwise).
CONDUIT_ENV=

# 32-byte key used to AES-256-GCM encrypt stored connector credentials
# (OAuth tokens, API keys). Required in production. Generate with:
#   openssl rand -base64 32
CONDUIT_ENCRYPTION_KEY=

# Shared HMAC secret used to verify inbound webhook signatures.
CONDUIT_WEBHOOK_SECRET=

# Optional: webhook URL that receives drift-detection alerts
# (posted by the background DriftDetector when a connector's schema drifts).
CONDUIT_ALERT_WEBHOOK_URL=
